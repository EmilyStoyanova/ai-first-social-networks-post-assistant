# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection for the app (pgBouncer)
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
# Direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@host/dbname"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with:  npx auth secret
#             or: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"
# Set to true on production hosts that sit behind a proxy (e.g. Vercel)
AUTH_TRUST_HOST="true"

# ─── Encryption (AES-256 for Buffer tokens & LLM API keys) ───────────────────
ENCRYPTION_KEY="generate-32-byte-hex-string"

# ─── Buffer ───────────────────────────────────────────────────────────────────
BUFFER_CLIENT_ID=""
BUFFER_CLIENT_SECRET=""
BUFFER_REDIRECT_URI="http://localhost:3000/api/v1/buffer/callback"

# ─── LLM Providers (configured in admin UI, stored in DB — these are fallbacks)
CLAUDE_API_KEY=""
OPENAI_API_KEY=""
GROK_API_KEY=""

# ─── Image Generation ─────────────────────────────────────────────────────────
LEONARDO_API_KEY=""

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
