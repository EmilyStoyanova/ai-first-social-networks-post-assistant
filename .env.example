# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32 bytes encoded as 64 hex characters.
# Used to encrypt LLM API keys and Buffer OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLM_ENCRYPTION_KEY=""

# ─── Buffer OAuth ─────────────────────────────────────────────────────────────
# Register your app at https://buffer.com/developers/apps
# The redirect URI must exactly match what is registered in your Buffer app.
BUFFER_CLIENT_ID=""
BUFFER_CLIENT_SECRET=""
BUFFER_REDIRECT_URI="http://localhost:3000/api/v1/buffer/callback"

# ─── AI / Generation ──────────────────────────────────────────────────────────
# Set to "true" to skip real LLM and image provider calls (deterministic mocks).
# Useful during development when API keys are not yet configured.
AI_MOCK_MODE="false"

# ─── LLM Providers ─────────────────────────────────────────────────────────────
# WHICH provider is used is NOT set here — a global admin activates providers and
# picks the default in the admin panel (stored as LlmConfig rows), and users may
# override per generation. Env only supplies credentials, model names, and URLs
# for the providers below. AI_MOCK_MODE=true bypasses all of them.

# ─── Groq ──────────────────────────────────────────────────────────────────────
# The Groq inference API (https://api.groq.com) — NOT xAI's Grok. Generous free
# tier; expect HTTP 429 rate limits on it under load.
# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: model to use (default: llama-3.3-70b-versatile).
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Create an API key at https://console.anthropic.com/settings/keys
# Required to activate the Claude provider.
ANTHROPIC_API_KEY=""
# Optional: model to use (default: claude-sonnet-4-6).
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is shared between LLM generation and image generation
# (IMAGE_PROVIDER=OPENAI). One key covers both.
# Optional: model to use for LLM text generation (default: gpt-4.1-mini).
OPENAI_MODEL="gpt-4.1-mini"

# ─── Local Text Worker ─────────────────────────────────────────────────────────
# Use a self-hosted Ollama-compatible worker for text generation.
# Both URL and key are required to activate the Text Worker provider.
TEXT_WORKER_URL="http://192.168.31.102:3002"
TEXT_WORKER_API_KEY=""
# Optional: model to use (default: qwen3:8b).
TEXT_WORKER_MODEL="qwen3:8b"

# ─── Semantic Embeddings (Phase 1.3 — local-first) ─────────────────────────────
# Selects the embedding backend for post semantic memory. Fully local-first:
# no cloud provider and no third-party API key is used.
#   worker  → the local TEXT_WORKER (POST {TEXT_WORKER_URL}/embed, bge-m3, 1024-dim).
#             Reuses TEXT_WORKER_URL + TEXT_WORKER_API_KEY. When either is unset
#             embeddings are SKIPPED cleanly and post generation continues normally.
#   mock    → deterministic offline vectors (also used when AI_MOCK_MODE=true).
#   (unset) → no active provider; embedding is skipped.
EMBEDDING_PROVIDER="worker"
# Optional: override the embedding vector dimension (default: 1024, matches the
# pgvector column and bge-m3). Only change alongside a vector-column migration.
# EMBEDDING_DIMENSIONS="1024"

# ─── Image Provider ────────────────────────────────────────────────────────────
# Selects the image generation backend.
# Supported values: IDEOGRAM (primary), MOCK (default/no key), FAL, OPENAI, LEONARDO.
# MOCK shows a placeholder image — no API key required.
# AI_MOCK_MODE=true overrides this setting regardless of what is set here.
IMAGE_PROVIDER="IDEOGRAM"

# ─── Ideogram Image Generation (primary provider) ──────────────────────────────
# Create an API key at https://ideogram.ai/manage-api
# Only required when IMAGE_PROVIDER=IDEOGRAM.
IDEOGRAM_API_KEY=""
# Optional: model version to use (default: V_2).
# Supported values: V_1, V_1_TURBO, V_2, V_2_TURBO, V_3
IDEOGRAM_MODEL="V_2"

# ─── Fal.ai Image Generation ───────────────────────────────────────────────────
# Create an API key at https://fal.ai/dashboard/keys
# Only required when IMAGE_PROVIDER=FAL.
FAL_API_KEY=""
# Optional: model to use (default: fal-ai/flux/schnell).
# Other options: fal-ai/flux/dev, fal-ai/flux-pro
FAL_MODEL="fal-ai/flux/schnell"

# ─── OpenAI Image Generation ───────────────────────────────────────────────────
# Only required when IMAGE_PROVIDER=OPENAI.
OPENAI_API_KEY=""
# Optional: model to use for image generation (default: gpt-image-1).
# Other supported values: dall-e-3, dall-e-2
OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── Leonardo.ai Image Generation ─────────────────────────────────────────────
# Sign up at https://leonardo.ai and create an API key under API Access.
# Only required when IMAGE_PROVIDER=LEONARDO.
LEONARDO_API_KEY=""
# Optional: a specific Leonardo model ID (e.g. "b24e16ff-06e3-43eb-8d33-4416c2d75876").
# Leave blank to use the Leonardo default model.
LEONARDO_MODEL_ID=""
# Optional: override the Leonardo base URL (default: https://cloud.leonardo.ai).
# LEONARDO_API_URL="https://cloud.leonardo.ai"

# ─── Custom Worker Image Generation ───────────────────────────────────────────
# Use a self-hosted worker (e.g. ComfyUI wrapper) for image generation.
# Both variables are required when IMAGE_PROVIDER=WORKER.
# IMAGE_WORKER_URL: full URL to the worker endpoint (POST, receives { prompt }).
# IMAGE_WORKER_API_KEY: sent as x-worker-api-key header on every request.
IMAGE_WORKER_URL="http://localhost:3001/generate-image"
IMAGE_WORKER_API_KEY=""

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used to send email verification messages on registration.
# Any SMTP provider works (e.g. Brevo, Mailgun, Postmark, Gmail).
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
# Set to "true" only for port 465 (implicit TLS). Leave "false" for STARTTLS (587).
EMAIL_SECURE="false"
EMAIL_USER="your-smtp-username"
EMAIL_PASS="your-smtp-password"
# The From address shown in the email client.
EMAIL_FROM="contact@edamame.digital"

# ─── App URL ───────────────────────────────────────────────────────────────────
# Public base URL of the app — used to build verification links.
# On Vercel this is set automatically; override here for local development.
APP_URL="http://localhost:3000"
