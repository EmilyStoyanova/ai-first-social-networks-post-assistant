generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  owner
  editor
}

enum AutomationMode {
  semi_automated
  fully_automated
}

enum SocialChannel {
  facebook
  linkedin
  instagram
  tiktok
}

enum HashtagStyle {
  inline
  end_of_post
  none
}

enum ContentSourceType {
  rss
  prompt
  product_page
  calendar_event
}

enum MediaSource {
  user_upload
  ai
}

enum ScheduleStatus {
  generating
  ready
  completed
}

// Where a post was written from, captured at generation time. Lowercase to match
// every other enum in this schema; the API/UI uppercase for display exactly as
// they do for PostStatus and SocialChannel.
enum PostOriginType {
  brand_setup
  content_source
}

enum PostStatus {
  draft
  pending_approval
  approved
  rejected
  sent_to_buffer
  published
  failed
}

// Outcome of the last attempt to read a post's metrics from Buffer (v2-7).
// These are genuinely different states, not shades of "error", and the UI
// distinguishes them — see lib/services/analytics/sync-post-metrics.service.ts.
enum MetricSyncStatus {
  // Metrics returned and stored.
  ok
  // Buffer answered, but reported no metrics for this post. Observed on a post
  // Buffer had already ingested (metricsUpdatedAt set) that still returned none.
  // Explicitly NOT zeros.
  no_data
  // The configured Personal API Key belongs to a different Buffer organization
  // than this post. Verified live: FORBIDDEN at path ["post"], data.post = null.
  forbidden
  // Buffer does not recognise the stored bufferUpdateId (deleted post, wrong org).
  not_found
  // Network failure, rate limit, or any unexpected Buffer response.
  error
}

enum LlmProvider {
  claude
  openai
  /// Groq (api.groq.com), NOT xAI's Grok. The value is a historical misnomer kept
  /// for DB compatibility; renaming it would require a data migration for no
  /// functional gain. User-facing name and provenance label are both "Groq"/"GROQ".
  grok
  text_worker
}

enum CronStatus {
  running
  completed
  failed
}

// ─── Background job queue (Phase 0) ───────────────────────────────────────────
// Lifecycle of a queued unit of work. A closed, well-defined set, so it is an
// enum (unlike Job.type, which is a plain string — see the Job model). Terminal
// states are completed | failed | cancelled; only queued | active are "live".
enum JobStatus {
  queued
  active
  completed
  failed
  cancelled
}

// ─── Generation trace ─────────────────────────────────────────────────────────
// What KIND of AI operation a run recorded. Deliberately not "everything is a
// post generation": translation, classification and product-page extraction are
// operations on a FEED ITEM that happen long before (and independently of) any
// post, and a post's trace REFERENCES them rather than copying the article text
// into every channel version of every post written from it.
enum GenerationRunKind {
  post_generation
  translation
  classification
  extraction
  image
}

// What asked for the run. `manual` is one person, one channel, one click;
// `manual_multi_channel` is that click fanned out across channels; `bulk` is a
// "generate N posts" batch; `cron` is the weekly scheduler; `preview` is the
// prompt preview, which executes real LLM work (aspect mining) but persists no
// post; `system` is background work with no requester (feed-item translation,
// classification, extraction).
enum GenerationTrigger {
  manual
  manual_multi_channel
  bulk
  cron
  preview
  system
}

enum GenerationRunStatus {
  running
  completed
  failed
}

enum GenerationStepStatus {
  success
  failed
  skipped
}

// Health/lifecycle of a worker process, reported via heartbeat. `draining` is a
// worker that has stopped claiming new jobs and is finishing in-flight work
// during graceful shutdown; `stopped` is a clean exit.
enum WorkerStatus {
  starting
  idle
  busy
  draining
  stopped
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  isGlobalAdmin Boolean  @default(false) @map("is_global_admin")
  preferredLang String   @default("en") @map("preferred_language")
  // Per-user preferred LLM config. Nullable = "use system default". The relation
  // is SetNull so deleting a config never orphans the FK — the user simply falls
  // back to the admin default at generation time.
  preferredLlmConfigId String? @map("preferred_llm_config_id")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  companies               CompanyMember[]
  createdCompanies        Company[]       @relation("CompanyCreator")
  uploadedAssets          MediaAsset[]
  approvedPosts           Post[]          @relation("PostApprover")
  rejectedPosts           Post[]          @relation("PostRejecter")
  generatedPosts          Post[]          @relation("PostGenerator")
  postVersions            PostVersion[]
  auditLogs               AuditLog[]
  generationRuns          GenerationRun[]
  apiKeys                 ApiKey[]
  preferredLlmConfig      LlmConfig?               @relation("UserPreferredLlm", fields: [preferredLlmConfigId], references: [id], onDelete: SetNull)
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Company {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  website              String?
  automationMode       AutomationMode @default(semi_automated) @map("automation_mode")
  defaultLang          String         @default("en") @map("default_language")
  // Content mix (v2-8) — weekly quota for posts written from the company's own
  // mission/brand knowledge, with no RSS article behind them. NULL means "no
  // quota configured"; together with a NULL on every ContentSource.postsPerWeek
  // it means this company has no content mix and keeps the pre-v2-8 pooling
  // behaviour. NULL and 0 are NOT the same: 0 means "no mission posts".
  companyContentPostsPerWeek Int?     @map("company_content_posts_per_week")
  createdBy            String         @map("created_by")
  lastCronProcessedAt  DateTime?      @map("last_cron_processed_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  creator          User              @relation("CompanyCreator", fields: [createdBy], references: [id])
  members          CompanyMember[]
  brandGuidelines  BrandGuidelines?
  channelConfigs   ChannelConfig[]
  bufferConnection BufferConnection?
  contentSources   ContentSource[]
  mediaAssets      MediaAsset[]
  weeklySchedules  WeeklySchedule[]
  posts            Post[]
  auditLogs        AuditLog[]
  generationRuns   GenerationRun[]

  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  role      Role
  invitedBy String?  @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@map("company_members")
}

model BrandGuidelines {
  id                   String   @id @default(uuid())
  companyId            String   @unique @map("company_id")
  logoUrl              String?  @map("logo_url")
  primaryColor         String?  @map("primary_color")
  secondaryColor       String?  @map("secondary_color")
  fontFamily           String?  @map("font_family")
  toneOfVoice          String?  @map("tone_of_voice")
  companyDescription   String?  @map("company_description")
  targetAudience       String?  @map("target_audience")
  forbiddenWords       String[] @map("forbidden_words")
  competitors          String[]
  // Topic priorities — which subjects are worth a post, in three ordered groups.
  // Consumed as HIGH / MEDIUM / REJECTED via lib/ai/topic-priorities.ts. Empty
  // in all three means "no rule configured", which every consumer must accept.
  topPriorityTopics    String[] @map("top_priority_topics")
  mediumPriorityTopics String[] @map("medium_priority_topics")
  avoidedTopics        String[] @map("avoided_topics")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("brand_guidelines")
}

model ChannelConfig {
  id                     String          @id @default(uuid())
  companyId              String          @map("company_id")
  channel                SocialChannel
  bufferProfileId        String?         @map("buffer_profile_id")
  bufferProfileName      String?         @map("buffer_profile_name")
  enabled                Boolean         @default(false)
  isActive               Boolean         @default(true) @map("is_active")
  imageRequired          Boolean?        @map("image_required")
  maxTextLength          Int?            @map("max_text_length")
  hashtagStyle           HashtagStyle    @default(end_of_post) @map("hashtag_style")
  // NULL = inherit the company brand default (Company.defaultLang). An explicit
  // "en"/"bg" overrides the brand default for this channel only. Resolution order:
  // manual generation choice → this override → Company.defaultLang.
  postingLanguage        String?         @map("posting_language")
  postsPerDay            Int             @default(1) @map("posts_per_day")
  postsPerWeek           Int             @default(5) @map("posts_per_week")
  postingWindows         Json?           @map("posting_windows")
  automationModeOverride AutomationMode? @map("automation_mode_override")
  includeSourceLink      Boolean         @default(false) @map("include_source_link")
  // When true, a post generated for this channel gets an AI image immediately,
  // with no "Generate image" click. Opt-in (default false) so existing channels
  // keep the manual-only behaviour and never start spending image credits from
  // a migration alone. Independent of `imageRequired`, which only validates that
  // an image is present and never produces one.
  autoGenerateImage      Boolean         @default(false) @map("auto_generate_image")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, bufferProfileId])
  @@index([companyId, isActive])
  @@map("channel_configs")
}

model BufferConnection {
  id              String    @id @default(uuid())
  companyId       String    @unique @map("company_id")
  bufferUserId    String    @map("buffer_user_id")
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  lastProfileSyncAt DateTime? @map("last_profile_sync_at")

  // ── Analytics credential (v2-7) ────────────────────────────────────────────
  // A Buffer *Personal API Key*, entirely separate from the OAuth tokens above.
  // Buffer refuses the `insights:read` scope to OAuth App Clients, so reading
  // metrics requires this key; publishing continues to use the OAuth token and is
  // unaffected. NULL = analytics disabled for this company (the expected default).
  // A key is scoped to ONE Buffer organization, so it is per-company by necessity:
  // posts owned by another Buffer account return FORBIDDEN.
  analyticsKeyEnc         String?   @map("analytics_key_enc")
  // Last 4 characters, stored in clear for UI display. The raw key is never
  // returned to a client — this is the only part that ever leaves the server.
  analyticsKeyLast4       String?   @map("analytics_key_last4")
  analyticsKeyAddedAt     DateTime? @map("analytics_key_added_at")
  // Stamped on every successful metrics call, so the UI can show a key that has
  // silently stopped working (Personal API Keys are revocable and never expire).
  analyticsKeyLastValidAt DateTime? @map("analytics_key_last_valid_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("buffer_connections")
}

// Runtime state for a supported LLM provider — one row per provider. Credentials,
// worker URLs, and model names come from environment variables (see
// lib/ai/llm/supported-providers.ts); this table stores ONLY which providers the
// admin has turned on and which single one is the global default.
model LlmConfig {
  id        String      @id @default(uuid())
  provider  LlmProvider @unique
  isActive  Boolean     @default(false) @map("is_active")
  // The single global default ("Auto"). At most one row is true at a time
  // (enforced by the service layer). A default is always active.
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  preferredByUsers User[] @relation("UserPreferredLlm")

  @@map("llm_configs")
}

model ContentSource {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  type          ContentSourceType
  name          String
  config        Json
  enabled       Boolean           @default(true)
  lastFetchedAt DateTime?         @map("last_fetched_at")
  // Content mix (v2-8) — how many of each channel's weekly posts must come from
  // this source. NULL = no quota assigned; see Company.companyContentPostsPerWeek.
  postsPerWeek   Int?             @map("posts_per_week")
  // LEGACY — retained for backwards compatibility, read by nothing.
  //
  // This once chose what happened when a source ran out of articles mid-week.
  // The product decision is that the behaviour is not a choice: the unwritten
  // posts always move to a source that still has articles (see
  // transferExhaustedQuotas). Whatever a row holds here is ignored, no code path
  // writes it, and it is absent from every type, DTO, and query. Kept only so
  // dropping it can be a deliberate migration rather than a side effect.
  fallbackPolicy String           @default("skip") @map("fallback_policy")
  createdAt     DateTime          @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feedItems FeedItem[]
  posts     Post[]

  @@map("content_sources")
}

model FeedItem {
  id          String    @id @default(uuid())
  sourceId    String    @map("source_id")
  companyId   String    @map("company_id")
  title       String?
  content     String?
  url         String
  publishedAt DateTime? @map("published_at")
  enabled     Boolean   @default(true) @map("enabled")
  usedInPost  Boolean   @default(false) @map("used_in_post")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// The main image of the ORIGINAL article, resolved once at ingestion so
  /// "Use source image" never has to scrape the page again. Priority is
  /// og:image → twitter:image → JSON-LD → feed enclosure → first substantial
  /// in-content image; icons, logos, avatars and tracking pixels are rejected.
  ///
  /// NULL for: items ingested before this column existed, non-RSS sources, and
  /// articles that genuinely have no usable image. Those simply do not offer the
  /// action — nothing else about them changes. Re-ingesting an item never
  /// overwrites a stored value with NULL, so a transient scrape failure cannot
  /// take the image away from a post that was already using it.
  sourceImageUrl String? @map("source_image_url")

  // How `content` above was obtained. Written by RSS ingestion only.
  //
  // NOT to be confused with the `extraction*` columns further down: those are
  // the product-page extraction feature (a model call against an owner's
  // instruction) and are always NULL for RSS. These describe whether the ARTICLE
  // BODY was actually read off the page, which used to be unknowable — a failed
  // fetch, a consent shell and a genuinely bodyless page all stored the feed's
  // one-sentence `<description>` and looked identical to a full article.
  /// readability | json_ld | dom | rss_summary — which reader produced `content`.
  contentExtraction      String?   @map("content_extraction")
  /// Length of `content` as stored, so thin items are queryable without a scan.
  contentChars           Int?      @map("content_chars")
  /// FALSE means `content` is the feed summary, NOT the article — such an item is
  /// excluded from post generation (see candidateWhereFor).
  ///
  /// NULL means "unknown", and is NOT the same as false: every row ingested
  /// before this column existed is NULL, as is every non-RSS source type. Those
  /// stay eligible. Treating NULL as incomplete would make the entire existing
  /// archive ungeneratable the moment this shipped.
  contentComplete        Boolean?  @map("content_complete")
  /// Why full-text extraction produced nothing — http_403, timeout_15000ms,
  /// parse_failed, no_article_text. The diagnostic that did not exist before.
  contentExtractionError String?   @map("content_extraction_error")
  contentExtractedAt     DateTime? @map("content_extracted_at")

  // Translation (v2-4). Written only for RSS sources with translation enabled.
  // `title` and `content` above always hold the ORIGINAL article text and are
  // never overwritten by translation; generation falls back to them unless
  // translationStatus is 'completed'.
  translatedTitle          String?   @map("translated_title")
  translatedContent        String?   @map("translated_content")
  /// ISO 639-1, e.g. "bg".
  translationLanguage      String?   @map("translation_language")
  /// pending | translating | completed | failed | skipped
  translationStatus        String?   @map("translation_status")
  /// sha256(title + content + targetLang) — unchanged content skips re-translation.
  translationHash          String?   @map("translation_hash")
  translationError         String?   @map("translation_error")
  translatedAt             DateTime? @map("translated_at")
  translationProvider      String?   @map("translation_provider")
  translationModel         String?   @map("translation_model")
  translationAttemptCount  Int       @default(0) @map("translation_attempt_count")
  translationLastAttemptAt DateTime? @map("translation_last_attempt_at")
  translationNextRetryAt   DateTime? @map("translation_next_retry_at")
  /// Set while a run holds an atomic claim (status = 'translating'). An expired
  /// lease means the worker died mid-translation and the item is reclaimable.
  translationLeaseExpiresAt DateTime? @map("translation_lease_expires_at")
  /// Raw (pre-restoration) MADLAD segment translations already banked for an
  /// oversized article that cannot finish all its HTTP batches inside one item
  /// budget — `{ "<segmentIndex>": "<raw MADLAD reply>", ... }`. NULL for every
  /// item that has never been capped mid-translation. Cleared back to NULL once
  /// the item reaches a terminal state (completed or failed), so a resumed
  /// article never leaks stale progress into an unrelated future retranslation.
  /// See maxBatchesFittingBudget (feed-item-translation.ts) and the resumable
  /// batch loop in madlad-translation.provider.ts.
  translationProgress Json? @map("translation_progress")

  // Product-page extraction. Written only for `product_page` sources whose config
  // carries `extractionInstructions` — the owner's own description of what a post
  // from that page must be built from.
  //
  // Same contract as translation above, for the same reason: `content` keeps the
  // RAW scraped page (title/description/pageText JSON) and is never overwritten,
  // so the input a result was derived from stays auditable and a re-extraction
  // always starts from the page rather than from its own previous output.
  // Generation prefers `extractedContent`, and only on `completed`.
  extractedContent       String?   @map("extracted_content")
  /// pending | extracting | completed | not_found | failed
  ///
  /// `not_found` is a SUCCESSFUL run whose answer was "the page does not contain
  /// this" — the honest outcome for an instruction asking for next week's events
  /// on a page that lists only this week's. Distinct from `failed` (the model or
  /// transport broke) because it must never be retried, and distinct from
  /// `completed` because generation must not write a post from it.
  extractionStatus       String?   @map("extraction_status")
  /// sha256(pageText + instructions) — an unchanged page and instruction skip re-extraction.
  extractionHash         String?   @map("extraction_hash")
  extractionError        String?   @map("extraction_error")
  extractedAt            DateTime? @map("extracted_at")
  extractionAttemptCount Int       @default(0) @map("extraction_attempt_count")

  // Topic classification. Written only for `rss` sources, and only once the
  // company has configured topic priorities on BrandGuidelines. Same contract as
  // translation and extraction above: `title`/`content` are never written here —
  // a verdict is derived from them (via resolveFeedItemContent, so a completed
  // translation is what gets judged) and stored alongside.
  //
  // `classification` NULL is "no verdict", never "rejected": it is what an
  // unconfigured company, a pending item, and a failed classification all look
  // like, and candidate selection must treat all three as eligible.
  /// HIGH | MEDIUM | REJECTED
  classification                String?   @map("classification")
  /// BLACKLIST | OUT_OF_SCOPE — set only when classification is REJECTED.
  classificationRejectionReason String?   @map("classification_rejection_reason")
  /// The CONFIGURED topics the article matched, in their stored spelling.
  classificationMatchedTopics   String[]  @map("classification_matched_topics")
  /// One capped sentence of evidence — why this verdict, for a human reading back.
  classificationReason          String?   @map("classification_reason")
  /// What the classifier judged the article to be ABOUT, in its own words — a fact
  /// about the article, not an argument for the verdict. Diagnostic: when a verdict
  /// looks wrong this says whether the article was misread or the topics misapplied.
  classificationMainSubject     String?   @map("classification_main_subject")
  /// The SINGLE configured topic the verdict rests on, in its stored spelling.
  /// NULL for OUT_OF_SCOPE, and for rows classified before this column existed.
  /// This is what decides HIGH vs MEDIUM — see lib/ai/feed-item-classification.ts.
  classificationPrimaryTopic    String?   @map("classification_primary_topic")
  /// pending | classifying | completed | skipped | failed
  classificationStatus          String?   @map("classification_status")
  /// sha256(sent text + topic-config fingerprint + company-context fingerprint) —
  /// unchanged inputs skip the call. The company-context part contributes nothing
  /// when the brand copy is blank, so pre-existing hashes still verify.
  classificationHash            String?   @map("classification_hash")
  classificationError           String?   @map("classification_error")
  classifiedAt                  DateTime? @map("classified_at")
  classificationProvider        String?   @map("classification_provider")
  classificationModel           String?   @map("classification_model")
  classificationAttemptCount    Int       @default(0) @map("classification_attempt_count")
  /// Set while a run holds an atomic claim (status = 'classifying'). An expired
  /// lease means the worker died mid-call and the item is reclaimable.
  classificationLeaseExpiresAt  DateTime? @map("classification_lease_expires_at")
  /// Whole-article classification (chunk analysis) — per-chunk analyses banked
  /// so far for an article too long for one classification call, keyed by
  /// chunk index as a string: `{ "<chunkIndex>": ChunkAnalysis, ... }`. Same
  /// contract as `translationProgress`: present only while a chunked run is
  /// incomplete (classificationStatus stays 'pending', more attempts remain),
  /// so the next claim resumes without re-analyzing a chunk that already
  /// succeeded. Cleared back to NULL once classification reaches a terminal
  /// state (completed or failed) — see lib/ai/classification-chunk-analysis.ts.
  classificationChunkProgress   Json?     @map("classification_chunk_progress")

  source ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // A feed item backs at most one post PER CHANNEL — one topic, written once for
  // each social channel it was generated for. Enforced at the DB level by the
  // composite unique index on Post(primaryFeedItemId, channel).
  //
  // `usedInPost` still means "this article has been consumed as a topic" and is
  // claimed exactly once, by the first channel; the siblings are pinned to the
  // article the topic already claimed and never claim it again.
  posts  Post[]
  /// Translation / classification / extraction traces for THIS article. A post
  /// written from it references the run rather than copying the article text
  /// again — see GenerationStep.linkedRunId.
  generationRuns GenerationRun[]

  @@unique([sourceId, url])
  @@index([sourceId])
  // Drives the cron translation batch: eligible items are selected by status and
  // ordered by next-retry time.
  @@index([translationStatus, translationNextRetryAt])
  // Recovery scan: reclaim in-flight claims ('translating') whose lease expired.
  @@index([translationStatus, translationLeaseExpiresAt])
  // Drives the product-page extraction drain: pending items, oldest first.
  @@index([extractionStatus, createdAt])
  // Drives the classification drain: eligible items per company, oldest first.
  @@index([classificationStatus, createdAt])
  // Recovery scan: reclaim in-flight claims ('classifying') whose lease expired.
  @@index([classificationStatus, classificationLeaseExpiresAt])
  @@map("feed_items")
}

model MediaAsset {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  cloudinaryId String      @map("cloudinary_id")
  url          String
  thumbnailUrl String?     @map("thumbnail_url")
  width        Int?
  height       Int?
  generatedBy  MediaSource @map("generated_by")
  aiPrompt     String?     @map("ai_prompt")
  imageStyle   String?     @map("image_style")
  uploadedBy   String      @map("uploaded_by")
  createdAt    DateTime    @default(now()) @map("created_at")

  /// The external address this image was IMPORTED from — set only for an image
  /// pulled in from a source article (FeedItem.sourceImageUrl). NULL for AI
  /// generations and user uploads.
  ///
  /// Two jobs: it is the dedupe key (re-importing the same article image reuses
  /// this row instead of paying for another Cloudinary upload), and it is how the
  /// UI knows the currently attached image IS the article's, which decides
  /// whether the card offers "Use source image" or "Use AI image".
  sourceUrl String? @map("source_url")

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])
  posts    Post[]  @relation("PostMedia")
  /// Posts holding this asset in reserve after a switch — see Post.previousMediaAssetId.
  previousForPosts Post[] @relation("PostPreviousMedia")

  @@index([companyId])
  /// Backs the import dedupe lookup (companyId + sourceUrl).
  @@index([companyId, sourceUrl])
  @@map("media_assets")
}

model WeeklySchedule {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  weekStart   DateTime       @map("week_start") @db.Date
  status      ScheduleStatus @default(generating)
  generatedAt DateTime?      @map("generated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posts   Post[]

  @@unique([companyId, weekStart])
  @@index([companyId])
  @@map("weekly_schedules")
}

model Post {
  id               String        @id @default(uuid())
  companyId        String        @map("company_id")
  scheduleId       String?       @map("schedule_id")
  // The single source article this post was generated from.
  //
  // Uniqueness is on (primaryFeedItemId, channel), not on the column alone: one
  // article is ONE topic, and a topic may be written once for each channel it
  // was generated for — a Facebook, an Instagram and a LinkedIn version of the
  // same story are three posts, not a duplicate. Two posts on the SAME channel
  // from the same article remain impossible, which is the half of
  // one-post-per-article that was ever about avoiding repetition.
  //
  // See the @@unique at the bottom of this model. NULL is unconstrained either
  // way (Postgres treats NULLs as distinct in a unique index), so mission and
  // evergreen posts are unaffected.
  primaryFeedItemId String?      @map("primary_feed_item_id")
  // The content TOPIC this post is one channel's version of. One id shared by
  // every channel version written from the same topic in the same request.
  //
  // Deliberately NOT `generationBatchId`, which is a different fact: a batch is
  // one "generate N posts" click and spans MANY topics, so grouping by it would
  // fold a whole run into one card. (The batch id also used to double as the
  // publisher's "a person chose this time" flag; that has since moved to
  // `manuallyScheduled`, which is now the only thing that answers it.)
  //
  // NULL = an ungrouped post: everything generated before this column existed,
  // and every cron post. Those render exactly as they always have — the card
  // falls back to a single-channel badge.
  contentGroupId    String?      @map("content_group_id")
  // The content-mix quota this post was drawn against (v2-8). NULL = company
  // content (mission/brand post, no RSS). This cannot be derived from
  // primaryFeedItemId: evergreen (prompt/calendar) posts and mission posts BOTH
  // leave that null, so without this column the scheduler could not tell which
  // quota a generated post consumed.
  contentSourceId  String?       @map("content_source_id")
  // ── Origin snapshot ────────────────────────────────────────────────────────
  // What this post was ACTUALLY written from, copied in at generation time and
  // never updated afterwards. The relations above cannot answer this durably:
  // deleting a ContentSource cascades to its FeedItems, which nulls
  // primaryFeedItemId and SetNulls contentSourceId, silently rewriting the
  // history of every post drawn from it — and renaming a source would
  // retroactively relabel old posts. A deliberate denormalization so a published
  // post's provenance is immutable.
  //
  // NULL originType = a post generated before this column existed and not
  // reached by the migration's backfill. Those fall back to the live relations
  // (see lib/posts/post-origin.ts) and are the only posts whose displayed origin
  // can still change.
  originType        PostOriginType? @map("origin_type")
  // All four are NULL for a brand_setup post — there is no source to describe.
  // `originSourceType` is what the badge reads to say "RSS · TechPowerUp" rather
  // than guessing the kind of source from its name.
  originSourceType  ContentSourceType? @map("origin_source_type")
  originSourceName  String?       @map("origin_source_name")
  originSourceTitle String?       @map("origin_source_title")
  originSourceUrl   String?       @map("origin_source_url")
  // The manual BULK generation that produced this post — one id shared by every
  // post of one "generate N posts between these dates" request. NULL for a
  // single manual generation and for every cron/scheduled post.
  //
  // A plain column rather than a `BulkGeneration` table: a batch has no state or
  // lifecycle of its own (each post is committed independently and reviewed on
  // its own), so the only fact worth persisting is which posts came from the
  // same click. The batch summary is returned to the caller, never stored.
  //
  // Purely an association. It used to double as the publisher's discriminator —
  // see `manuallyScheduled`, which now holds that fact on its own.
  generationBatchId String?       @map("generation_batch_id")
  // Whether a PERSON named this post's publish time, as opposed to the weekly
  // filler estimating one for it. THE publisher's discriminator: false means
  // `scheduledFor` is an estimate and the post may go out early (up to the cron
  // look-ahead), true means the time is a promise and the post waits for it —
  // and is parked rather than fired late once the grace window passes. See
  // lib/scheduling/publish-window.ts.
  //
  // Split out from `generationBatchId` because the two are different facts that
  // only used to coincide: manual BULK generation was the one way a person could
  // name a time, so "belongs to a batch" was a usable stand-in for "somebody
  // chose this". A single post can now be scheduled at generation and from its
  // own card, neither of which is a batch — so the fact is stored directly
  // instead of inferred from an association that no longer implies it.
  manuallyScheduled Boolean       @default(false) @map("manually_scheduled")
  channel          SocialChannel
  content          String
  language         String        @default("en")
  hashtags         String[]
  mediaAssetId     String?       @map("media_asset_id")
  // The image DISPLACED by the last switch between the AI image and the source
  // article's image, kept so the user can go back without regenerating. Purely a
  // second pointer: switching re-points these two columns and never deletes a
  // MediaAsset, so an already-paid-for AI generation is never lost.
  //
  // Only the two switch services write it. A later "Regenerate image" leaves it
  // pointing at an older asset, which is invisible: the card offers "Use AI
  // image" only while the CURRENT asset is the imported one, and any switch
  // rewrites the column first.
  previousMediaAssetId String?   @map("previous_media_asset_id")
  status           PostStatus    @default(draft)
  bufferUpdateId   String?       @map("buffer_update_id")
  publishedPostUrl String?       @map("published_post_url")
  scheduledFor     DateTime?     @map("scheduled_for")
  publishedAt      DateTime?     @map("published_at")
  safetyFlagged    Boolean       @default(false) @map("safety_flagged")
  safetyFlagReason String?       @map("safety_flag_reason")
  retryCount       Int           @default(0) @map("retry_count")
  lastError        String?       @map("last_error")
  generatedById    String?       @map("generated_by")
  imagePrompt      String?       @map("image_prompt")
  notes            String?
  // The single central claim/takeaway of the post (Phase 1.1). Nullable — legacy
  // posts predating this column stay null; also mirrored in promptSnapshot.coreMessage.
  coreMessage      String?       @map("core_message")
  promptSnapshot   Json?         @map("prompt_snapshot")
  llmProvider      String?       @map("llm_provider")
  llmModel         String?       @map("llm_model")
  approvedById     String?       @map("approved_by")
  approvedAt       DateTime?     @map("approved_at")
  rejectedById     String?       @map("rejected_by")
  rejectedAt       DateTime?     @map("rejected_at")
  rejectionNotes   String?       @map("rejection_notes")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  schedule        WeeklySchedule? @relation(fields: [scheduleId], references: [id])
  primaryFeedItem FeedItem?      @relation(fields: [primaryFeedItemId], references: [id])
  // SetNull, not Cascade: deleting a source must never delete posts already
  // written from it. The post then reads as company content for quota counting,
  // which only affects the current week — a deleted source has no quota anyway.
  contentSource   ContentSource? @relation(fields: [contentSourceId], references: [id], onDelete: SetNull)
  mediaAsset  MediaAsset?     @relation("PostMedia", fields: [mediaAssetId], references: [id])
  // Named only because a second Post→MediaAsset relation now exists; the FK and
  // column are unchanged.
  previousMediaAsset MediaAsset? @relation("PostPreviousMedia", fields: [previousMediaAssetId], references: [id])
  generatedBy User?           @relation("PostGenerator", fields: [generatedById], references: [id])
  approvedBy  User?           @relation("PostApprover", fields: [approvedById], references: [id])
  rejectedBy  User?           @relation("PostRejecter", fields: [rejectedById], references: [id])
  versions    PostVersion[]
  semantics   PostSemantics?
  metrics         PostMetric?
  metricSnapshots PostMetricSnapshot[]
  /// Every AI operation that produced (or acted on) this post, newest last. A
  /// post normally has exactly one, but the model is a list because regeneration
  /// and later image work are separate runs.
  generationRuns  GenerationRun[]

  @@index([companyId, status])
  @@index([scheduledFor])
  @@index([retryCount, status])
  // Backs the scheduler's per-run "what has this week generated so far, and from
  // which source" count. Every cron run does this before generating.
  @@index([scheduleId, channel, contentSourceId])
  // Backs "show me everything that bulk run produced", always asked within one
  // company. Partial in effect: the column is NULL for every non-bulk post.
  @@index([companyId, generationBatchId])
  // Backs the grouped posts list — "which channel versions belong together" —
  // which is always asked within one company. NULL for every ungrouped post.
  @@index([companyId, contentGroupId])
  // One post per (article, channel). See the note on primaryFeedItemId.
  @@unique([primaryFeedItemId, channel])
  @@map("posts")
}

// ─── Post analytics (v2-7) ────────────────────────────────────────────────────
// Engagement metrics read from Buffer with a per-company Personal API Key.
//
// Two rules govern every column here, both learned from live data (see
// docs/v2/v2-6-buffer-analytics-spike.md#verified-findings-2026-07-20):
//
//  1. NULL means "the network did not report this metric"; 0 means a real zero.
//     Buffer's `value` is a non-null Float that DEFAULTS TO 0 for unsupported
//     metrics, so the value alone cannot distinguish the two. Availability is
//     signalled by the metric type's PRESENCE in the response array — a column is
//     written only when its type appears there. Facebook never returns `reach`;
//     Instagram never returns `impressions` or `clicks`.
//  2. The channel here is BUFFER's `channelService`, never Post.channel. All 9
//     published posts are stored channel=facebook while Buffer reports instagram
//     for two of them, so attributing by our own column misfiles the metrics.

model PostMetric {
  id        String @id @default(uuid())
  postId    String @unique @map("post_id")
  // Denormalized so company-level weekly/monthly rollups never need to join posts.
  companyId String @map("company_id")

  // Buffer's own view of which network this went to — authoritative. Kept as a
  // plain String rather than the SocialChannel enum because it is Buffer's
  // vocabulary, and an unrecognised service must be storable rather than crash.
  channelService String? @map("channel_service")

  // Cross-network metrics.
  reactions Int?
  comments  Int?
  shares    Int?
  // Facebook only, in observed data.
  impressions Int?
  clicks      Int?
  // Instagram only, in observed data.
  reach     Int?
  views     Int?
  saves     Int?
  follows   Int?

  // Buffer's NATIVE engagement rate as a percentage — never derived by us.
  // Present on both Facebook and Instagram, but computed on different
  // denominators (FB: impressions, IG: reach), so it is not comparable across
  // channels. engagementRateDenominator records which one, and the UI labels it
  // rather than presenting a blended figure.
  engagementRate            Float?  @map("engagement_rate")
  engagementRateDenominator String? @map("engagement_rate_denominator")

  // The untouched metrics array as Buffer returned it. Buffer has 16 metric types
  // and may add more; this preserves anything the columns above do not model,
  // without a migration.
  raw Json?

  // Buffer's own ingestion timestamp (it refreshes metrics once daily, so values
  // lag the network by up to ~24h). Distinct from collectedAt, which is when WE
  // read them.
  metricsUpdatedAt DateTime? @map("metrics_updated_at")
  collectedAt      DateTime  @map("collected_at")

  syncStatus MetricSyncStatus @default(ok) @map("sync_status")
  syncError  String?          @map("sync_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Drives the cron's "least recently synced first" selection.
  @@index([companyId, collectedAt])
  @@map("post_metrics")
}

// Append-only history. Buffer returns cumulative lifetime totals with no
// time-series surface of its own, so day-over-day movement exists ONLY if we
// snapshot it ourselves — and it cannot be backfilled later.
//
// This is also the substrate for the weekly/monthly company aggregation that
// comes next: (companyId, snapshotAt) lets a rollup job sum a period directly,
// and channelService lets it segment by network without touching Post.
model PostMetricSnapshot {
  id             String  @id @default(uuid())
  postId         String  @map("post_id")
  companyId      String  @map("company_id")
  channelService String? @map("channel_service")

  reactions   Int?
  comments    Int?
  shares      Int?
  impressions Int?
  clicks      Int?
  reach       Int?
  views       Int?
  saves       Int?
  follows     Int?

  engagementRate            Float?  @map("engagement_rate")
  engagementRateDenominator String? @map("engagement_rate_denominator")

  snapshotAt DateTime @map("snapshot_at")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, snapshotAt(sort: Desc)])
  @@index([companyId, snapshotAt])
  // One snapshot per post per sync. Makes the daily cron idempotent: a re-run on
  // the same day updates rather than inflating history with duplicate rows.
  @@unique([postId, snapshotAt])
  @@map("post_metric_snapshots")
}

// ─── Semantic memory (Phase 1.2) ──────────────────────────────────────────────
// One row per Post, holding the pgvector embedding of the post's coreMessage.
// Deliberately a separate 1:1 table (not columns on Post): the vector is large,
// derived, optional, regeneratable, and can fail independently of the post.
//
// The `embedding` column is `Unsupported("vector(1024)")` — Prisma cannot type
// pgvector, so it is written/read via raw SQL (see post-semantics store in
// embed-post.service.ts). Every non-vector field is normal typed Prisma.
// Dimension 1024 matches bge-m3 served by the local TEXT_WORKER /embed endpoint.
//
// companyId/channel/postCreatedAt are denormalized from Post. All three are
// immutable for a post's lifetime, so they never drift; they exist so the future
// "latest N posts for this company+channel" gate query is a single index scan
// with no join. No ANN index yet — that is intentionally deferred.
model PostSemantics {
  postId            String                       @id @map("post_id")
  embedding         Unsupported("vector(1024)")?
  embeddingProvider String?                      @map("embedding_provider")
  embeddingModel    String?                      @map("embedding_model")
  embeddingDims     Int?                         @map("embedding_dims")
  // SHA-256 of the exact text that was embedded (the trimmed coreMessage).
  // Lets us skip re-embedding when the source text has not changed.
  coreMessageHash   String?                      @map("core_message_hash")
  // pending | ready | failed. Only "ready" rows carry a usable embedding.
  status            String                       @default("pending")
  attempts          Int                          @default(0)
  lastError         String?                      @map("last_error")

  // ── Semantic-gate calibration diagnostics (Phase 1.5) ──────────────────────
  // The gate outcome for THIS post when it was generated. Queryable home for
  // calibration (not duplicated as columns on Post). Written best-effort right
  // after the post is created, independent of whether embedding succeeded, so
  // even skipped-gate generations leave a calibration record. All nullable —
  // legacy rows and rows written only by the embed path leave them null.
  gateTopSimilarity Float?                       @map("gate_top_similarity")
  gateMatchedPostId String?                      @map("gate_matched_post_id")
  gateDecision      String?                      @map("gate_decision")
  gateAttempts      Int?                         @map("gate_attempts")
  gateSkipped       Boolean?                     @map("gate_skipped")
  gateEvaluatedAt   DateTime?                    @map("gate_evaluated_at")

  // Denormalized immutable routing keys for the future recency-window gate.
  companyId         String                       @map("company_id")
  channel           SocialChannel
  postCreatedAt     DateTime                     @map("post_created_at")

  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([companyId, channel, postCreatedAt(sort: Desc)])
  @@index([status])
  @@map("post_semantics")
}

model PostVersion {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  version   Int
  content   String
  changedBy String   @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  changer User @relation(fields: [changedBy], references: [id])

  @@unique([postId, version])
  @@map("post_versions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  companyId  String?  @map("company_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Generation trace ─────────────────────────────────────────────────────────
//
// ONE AI operation, and every step it took, captured as it happened.
//
// The whole point of these two tables is that they are a SNAPSHOT and never a
// view: a post generated in March must still show March's brand guidelines,
// March's channel settings and March's exact prompts after every one of those has
// been edited. So nothing here is a foreign key to live configuration — the
// values are copied in, as JSON, at the moment they were used. The only foreign
// keys are identity ones (which post, which company, which article), and they
// exist to FIND a trace, never to reconstruct it.
//
// A run is not one giant JSON blob on Post for two reasons. A post may have
// several AI operations over its life (it was generated, and its image may be
// regenerated later), and the steps of one operation need to be queryable and
// individually renderable — a 300KB column that must be parsed whole to show a
// timeline header is the thing this design exists to avoid.
model GenerationRun {
  id String @id @default(uuid())

  /// The company the work was done for. Nullable only because a run can fail
  /// before the company is resolved (an unknown slug, a membership check that
  /// said no) — every run that reached an LLM has one.
  companyId String? @map("company_id")

  /// The post this run produced, once it exists. NULL while the run is in flight
  /// and permanently NULL for a run that produced no post — a generation aborted
  /// by the uniqueness gate, a preview, or a feed-item operation. Those runs are
  /// deliberately kept: "why did this not produce a post" is the question a trace
  /// is most often opened to answer.
  postId String? @map("post_id")

  /// The article a feed-item operation acted on (translation / classification /
  /// extraction). NULL for post generation, whose article is recorded in the
  /// source step instead — a post's run is about the post, not about one article.
  feedItemId String? @map("feed_item_id")

  kind    GenerationRunKind
  trigger GenerationTrigger
  status  GenerationRunStatus @default(running)

  /// Channel and content language, denormalized off the steps so the admin list
  /// can be filtered and read without opening every run.
  channel  SocialChannel?
  language String?

  /// Who asked. NULL for cron and for every background feed-item operation.
  userId String? @map("user_id")

  /// Associations that let one request's runs be found together: the content
  /// group is one topic across channels, the batch is one bulk click, the
  /// schedule is one cron week, the job is the queue entry that executed it.
  contentGroupId    String? @map("content_group_id")
  generationBatchId String? @map("generation_batch_id")
  scheduleId        String? @map("schedule_id")
  jobId             String? @map("job_id")

  /// Provenance of the model that did the work, as resolved for THIS run. A
  /// string rather than the LlmProvider enum for the same reason PostMetric keeps
  /// Buffer's own vocabulary: this is a historical label, and an unrecognised one
  /// must be storable rather than crash.
  llmProvider String? @map("llm_provider")
  llmModel    String? @map("llm_model")

  /// How many generation attempts the run made (1..MAX_GENERATION_ATTEMPTS). 0
  /// for a run that never reached the model.
  attempts Int @default(0)

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  /// The terminal failure, when there was one — the service's own error code
  /// (CANNOT_GENERATE_UNIQUE_POST, LLM_RATE_LIMITED, …) and its message.
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  /// The request options as they arrived, sanitized. What was ASKED for, as
  /// opposed to what was resolved — the latter is the context step's job.
  options Json?

  /// True when any captured value hit a size cap and was shortened. Surfaced in
  /// the UI so a reader never mistakes a truncated prompt for the whole one.
  truncated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post     Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  feedItem FeedItem? @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a user must never delete the history of what
  /// their generations did.
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps    GenerationStep[]

  /// The trace viewer's own lookup: everything this post's generation did.
  @@index([postId])
  /// The admin list — a company's runs, newest first, including the ones that
  /// produced no post.
  @@index([companyId, startedAt(sort: Desc)])
  /// Resolving the translation/classification run a post's step links to.
  @@index([feedItemId, kind, startedAt(sort: Desc)])
  /// "Show me every channel version of this topic's generation."
  @@index([contentGroupId])
  @@index([generationBatchId])
  @@map("generation_runs")
}

// One step of one run — a thing that happened, with what went in and what came
// out.
//
// `type` is a PLAIN STRING rather than an enum, for the reason Job.type and
// AuditLog.action are: a new pipeline stage must not need a schema migration to
// become visible, and the closed vocabulary that matters (did it succeed) is the
// status enum beside it. The known types are listed in lib/generation-trace/
// step-types.ts, which is also what orders the timeline.
model GenerationStep {
  id    String @id @default(uuid())
  runId String @map("run_id")

  /// Execution order within the run, 1-based and dense. THE ordering — never
  /// startedAt, which ties for steps that are recorded in the same millisecond.
  sequence Int

  type   String
  /// Human label for the timeline header when the type alone is ambiguous
  /// ("Attempt 2 of 3", "Article image import").
  label  String?
  status GenerationStepStatus

  /// Which generation attempt this step belongs to, for the steps that repeat
  /// (prompt / llm_call / raw_response / validation). NULL for steps that happen
  /// once per run.
  attempt Int?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  /// The step's own payload, sanitized and size-capped. Split three ways because
  /// that is how a reader asks about a step: what did it receive, what did it
  /// produce, and what else is worth knowing (sizes, thresholds, decisions).
  input    Json?
  output   Json?
  metadata Json?

  errorMessage String? @map("error_message")

  /// The run that holds this step's full detail, when the step is a REFERENCE to
  /// an immutable artifact produced elsewhere — a feed item's translation or
  /// classification run. The post's step keeps the verdict and an excerpt; the
  /// linked run keeps the prompts and the raw response, once, however many posts
  /// were later written from that article.
  ///
  /// Deliberately NOT a relation: the linked run may be deleted (its feed item
  /// cascades away with its source) while this step must survive as the record of
  /// what the post was built from. A dangling id renders as "detail no longer
  /// available", which is the truth.
  linkedRunId String? @map("linked_run_id")

  run GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
  @@map("generation_steps")
}

model CronRun {
  id           String     @id @default(uuid())
  startedAt    DateTime   @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  status       CronStatus @default(running)
  actionsTaken Json?      @map("actions_taken")
  error        String?

  @@map("cron_runs")
}

// A single unit of background work claimed and executed by an external worker
// (Phase 0 — table only; nothing enqueues or executes jobs yet). Neon is the
// source of truth; the queue is just this table.
//
// `type` is a PLAIN STRING, not an enum, on purpose: new job kinds must not need
// a schema migration, and the payload is already untyped-at-the-DB Json validated
// per-type in the service layer (mirrors AuditLog.action and translationStatus).
// The closed lifecycle lives in JobStatus instead.
model Job {
  id      String    @id @default(uuid())
  type    String
  status  JobStatus @default(queued)
  // Type-specific input. Validated with a per-type Zod schema at enqueue/dequeue.
  payload Json

  // Duplicate-active guard. At most one non-terminal job may share a dedupeKey,
  // enforced by a PARTIAL UNIQUE index (WHERE status IN ('queued','active')) that
  // Prisma cannot express — it lives only in the migration SQL. NULL opts out.
  dedupeKey String? @map("dedupe_key")

  // Higher runs first; manual/interactive work outranks cron fan-out.
  priority Int @default(0)
  // Scheduling/backoff gate: a job is claimable only once runAt <= now().
  runAt    DateTime @default(now()) @map("run_at")

  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  // Lease — stale-lock recovery. A crashed worker leaves status=active with an
  // expired leaseExpiresAt; the reaper requeues it. lockedBy is a worker name,
  // deliberately NOT a FK so pruning a worker row never blocks or cascades a job.
  lockedBy       String?   @map("locked_by")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  lastError String? @map("last_error")
  // Success/diagnostic output; reuses the existing *Summary shapes per job type.
  result    Json?

  // Linkage & observability (all optional — a job need not belong to a company).
  companyId String? @map("company_id")
  createdBy String? @map("created_by")
  cronRunId String? @map("cron_run_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt, priority])
  @@index([companyId])
  @@index([cronRunId])
  @@map("jobs")
}

// A worker process (Phase 0 — table only). One row per process, keyed by a stable
// `name` (env WORKER_ID, else hostname:pid) so a restart updates its row rather
// than orphaning it. lastHeartbeatAt drives liveness: a worker silent longer than
// the lease TTL is treated as dead and its in-flight jobs are reclaimed.
model Worker {
  id              String       @id @default(uuid())
  name            String       @unique
  status          WorkerStatus @default(starting)
  hostname        String?
  pid             Int?
  concurrency     Int          @default(1)
  // Free-form process metadata (build sha, region, capabilities) — future-proof
  // without a migration.
  metadata        Json?
  lastHeartbeatAt DateTime?    @map("last_heartbeat_at")
  startedAt       DateTime     @default(now()) @map("started_at")
  stoppedAt       DateTime?    @map("stopped_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("workers")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique @map("key_hash")
  createdBy  String    @map("created_by")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("api_keys")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
